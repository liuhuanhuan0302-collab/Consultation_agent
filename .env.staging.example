# 测试环境配置 - 复制为 .env.staging，绝不能复用生产 DATABASE_URL/SECRET_KEY

ENVIRONMENT=staging

# 由 mysql_staging_init 在共用 MySQL 服务内创建，名称必须以 _test 或 _staging 结尾
STAGING_MYSQL_DATABASE=consultation_agent_test
STAGING_MYSQL_USER=consult_agent_test
STAGING_MYSQL_PASSWORD=replace-with-letters-numbers-dots-dashes
DATABASE_URL=mysql+pymysql://consult_agent_test:replace-with-letters-numbers-dots-dashes@mysql:3306/consultation_agent_test?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 必须替换；占位值（change-*/replace-* 开头）会被程序拒绝启动
SECRET_KEY=replace-with-a-different-staging-secret
INITIAL_ADMIN_EMAIL=test-admin@your-company.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# 可以共用 DeepSeek Key，但测试调用同样会产生费用
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
REPORT_GENERATION_CONCURRENCY=2
MAX_PENDING_REPORT_JOBS=20
MAX_LEADS_PER_EMAIL_PER_HOUR=20
PDF_BROWSER_RENDER=true
PDF_BROWSER_EXECUTABLE=
# 容器环境（no-new-privileges + cap_drop ALL）中 Chromium 沙箱无法启动，必须开启
PDF_BROWSER_NO_SANDBOX=true
# 客户邮件附件仅允许由客户 DOCX 经 LibreOffice 转为 PDF；关闭或转换不可用会阻止投递并转人工处理
PDF_DOCX_RENDER=true
# 兼容保留的旧开关；不影响客户附件，转换失败不会回退 Chromium
PDF_DOCX_FALLBACK_TO_BROWSER=false
# 留空时自动探测 libreoffice/soffice；超时范围 10-600 秒
LIBREOFFICE_EXECUTABLE=
LIBREOFFICE_TIMEOUT=180

PUBLIC_WEB_BASE_URL=http://8.138.165.2:8081/diagnosis
CORS_ORIGINS=http://8.138.165.2:8081

# 如需测试发信可复用 SMTP，但收件人必须在允许名单中，多个邮箱用逗号分隔
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI 原生转型诊断（测试）
SMTP_RECIPIENT_ALLOWLIST=tester@your-company.com
