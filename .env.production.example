# 生产环境变量模板 - 复制为 .env.production 后填写真实值

ENVIRONMENT=production

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=consultation_agent
MYSQL_USER=consult_agent
MYSQL_PASSWORD=change-this-db-password

DATABASE_URL=mysql+pymysql://consult_agent:change-this-db-password@mysql:3306/consultation_agent?charset=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# 必须替换为强随机密钥（如 openssl rand -hex 32）；占位值（change-*/replace-* 开头）会被程序拒绝启动
SECRET_KEY=change-this-secret-key
# 必须替换；占位值会被程序拒绝启动
INITIAL_ADMIN_EMAIL=admin@your-company.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
REPORT_GENERATION_CONCURRENCY=5
MAX_PENDING_REPORT_JOBS=100
MAX_LEADS_PER_EMAIL_PER_HOUR=3
PDF_BROWSER_RENDER=true
PDF_BROWSER_EXECUTABLE=
# 容器环境（no-new-privileges + cap_drop ALL）中 Chromium 沙箱无法启动，必须开启
PDF_BROWSER_NO_SANDBOX=true

# 生产环境强制 HTTPS：后端会拒绝 http:// 配置启动（客户资料与登录 Cookie 不得明文传输）。
# 部署时替换为真实域名，并配置 TLS 证书（见 deploy/nginx/consultation-agent.conf）
PUBLIC_WEB_BASE_URL=https://your-domain.com/diagnosis
CORS_ORIGINS=https://your-domain.com

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI 原生转型诊断
SMTP_RECIPIENT_ALLOWLIST=
