APP_NAME=Consultation Diagnosis Agent
ENVIRONMENT=development
DATABASE_URL=sqlite:///./consultation_agent.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
SECRET_KEY=change-me-before-production
GATEWAY_ENCRYPTION_KEY=
# GATEWAY_ENCRYPTION_KEY 用于加密后台 API 网关页保存的密钥；留空则从 SECRET_KEY 派生。轮换后需在后台重新填写网关密钥
ACCESS_TOKEN_EXPIRE_MINUTES=720
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=45
REPORT_GENERATION_CONCURRENCY=5
MAX_PENDING_REPORT_JOBS=100
MAX_LEADS_PER_EMAIL_PER_HOUR=3
PDF_BROWSER_RENDER=true
PDF_BROWSER_EXECUTABLE=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI 原生转型诊断
PUBLIC_WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
